# Storefront Vercel project > Settings > Environment Variables > Production.
# These public URLs come from the current root .env; confirm each deployment URL
# in Vercel before using them. Set the same four values in all three projects.
# API_URL is the backend origin only: no /api path or trailing route.
API_URL=https://ecommerce-api-nv32.onrender.com
# Public app origins; no /en/login, other path, or trailing route.
NEXT_PUBLIC_STOREFRONT_URL=https://ecommerce-frontend-storefront-two.vercel.app
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://ecommerce-frontend-admin-dashboard.vercel.app
NEXT_PUBLIC_VENDOR_DASHBOARD_URL=https://ecommerce-frontend-vendor-dashboard.vercel.app
# No AUTH_HANDOFF_CLIENT_SECRET belongs in the storefront project.
# A root .env does not replace this app's Vercel Production settings.
