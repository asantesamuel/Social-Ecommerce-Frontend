# Admin dashboard Vercel project > Settings > Environment Variables > Production.
# Confirm these public deployment URLs in Vercel before using them.
# API_URL is the backend origin only, without /api or any other path.
API_URL=https://ecommerce-api-nv32.onrender.com
# These three values must be the same in all three frontend projects.
NEXT_PUBLIC_STOREFRONT_URL=https://ecommerce-frontend-storefront-two.vercel.app
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://ecommerce-frontend-admin-dashboard.vercel.app
NEXT_PUBLIC_VENDOR_DASHBOARD_URL=https://ecommerce-frontend-vendor-dashboard.vercel.app
# This client ID must match the backend's registered admin handoff client.
AUTH_HANDOFF_CLIENT_ID=admin-dashboard
# REQUIRED: use the exact value of backend AUTH_HANDOFF_ADMIN_CLIENT_SECRET.
# Do not commit the real value or prefix its name with NEXT_PUBLIC_.
# If creating a new secret, generate a different random value for each dashboard
# (for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))").
# Enter that same value in the backend and this Vercel project, not this file.
AUTH_HANDOFF_CLIENT_SECRET=
# Must exactly match backend AUTH_HANDOFF_ADMIN_CALLBACK_URL.
AUTH_HANDOFF_CALLBACK_URL=https://ecommerce-frontend-admin-dashboard.vercel.app/auth/callback
# A root .env does not replace this app's Vercel Production settings.
